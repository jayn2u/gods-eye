# Copy to .env for local development. Do not commit machine-specific paths.
GODS_EYE_DATA_HOME=./data
GODS_EYE_DATASET_ROOT=./data/datasets
GODS_EYE_INDEX_ROOT=./indexes
GODS_EYE_ACTIVE_INDEX=./indexes/active
GODS_EYE_MODEL_ID=openai/clip-vit-base-patch16
GODS_EYE_MODEL_REVISION=
GODS_EYE_HF_CACHE=./.cache/huggingface
GODS_EYE_OFFLINE=false
GODS_EYE_DEVICE=auto
GODS_EYE_BATCH_SIZE=32
GODS_EYE_BIND_HOST=127.0.0.1
GODS_EYE_BIND_PORT=8000
GODS_EYE_USE_FIXTURES=false
GODS_EYE_LOG_LEVEL=INFO
