#!/bin/sh

set -eu

if ! command -v docker >/dev/null 2>&1; then
    printf '%s\n' "God's Eye requires Docker Engine. Install Docker, then run './gods-eye doctor' again." >&2
    exit 2
fi

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export GODS_EYE_HOST_PROJECT_ROOT="$SCRIPT_DIR"
export GODS_EYE_DOCKER_BIN
GODS_EYE_DOCKER_BIN=$(command -v docker)
export GODS_EYE_HOST_COMPOSE_VERSION
GODS_EYE_HOST_COMPOSE_VERSION=$(docker compose version --short 2>/dev/null || true)
export GODS_EYE_DOCKER_COMPOSE_PLUGIN
if GODS_EYE_DOCKER_COMPOSE_PLUGIN=$(docker info --format '{{range .ClientInfo.Plugins}}{{if eq .Name "compose"}}{{.Path}}{{end}}{{end}}' 2>/dev/null); then
    :
else
    printf '%s\n' "Docker daemon is unavailable; start Docker Engine, then run './gods-eye doctor' again." >&2
    exit 2
fi
if [ -z "$GODS_EYE_DOCKER_COMPOSE_PLUGIN" ]; then
    printf '%s\n' "Docker Compose plugin could not be located; install Compose v2 before running God's Eye." >&2
    exit 2
fi

release_manifest=${GODS_EYE_RELEASE_MANIFEST:-$SCRIPT_DIR/release-images.env}
if [ -f "$release_manifest" ]; then
    release_version=$(sed -n 's/^GODS_EYE_RELEASE_VERSION=//p' "$release_manifest" | head -n 1)
    service_image=$(sed -n 's/^GODS_EYE_SERVICE_IMAGE=//p' "$release_manifest" | head -n 1)
    web_image=$(sed -n 's/^GODS_EYE_WEB_IMAGE=//p' "$release_manifest" | head -n 1)
    if ! printf '%s\n' "$release_version" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$' \
        || ! printf '%s\n' "$service_image" | grep -Eq "^ghcr\.io/jayn2u/gods-eye-service@sha256:[0-9a-f]{64}$" \
        || ! printf '%s\n' "$web_image" | grep -Eq "^ghcr\.io/jayn2u/gods-eye-web@sha256:[0-9a-f]{64}$"; then
        printf '%s\n' "release-images.env contains an invalid immutable image reference." >&2
        exit 65
    fi
    export GODS_EYE_IMAGE_MODE=release
    export GODS_EYE_RELEASE_VERSION="$release_version"
    export GODS_EYE_SERVICE_IMAGE="$service_image"
    export GODS_EYE_WEB_IMAGE="$web_image"
    export GODS_EYE_COMPOSE_FILE=/workspace/compose.yaml:/workspace/compose.release.yaml
    printf 'Using immutable release images for %s.\n' "$release_version" >&2
    exec docker compose \
        --project-directory "$SCRIPT_DIR" \
        -f "$SCRIPT_DIR/compose.yaml" \
        -f "$SCRIPT_DIR/compose.release.yaml" \
        --profile tools run --rm launcher "$@"
fi

export GODS_EYE_IMAGE_MODE=local
export GODS_EYE_COMPOSE_FILE=/workspace/compose.yaml
export GODS_EYE_SERVICE_IMAGE=gods-eye-service:local
export GODS_EYE_WEB_IMAGE=gods-eye-web:local
gods_eye_digest() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
    else
        shasum -a 256 | cut -d' ' -f1
    fi
}

# Everything Dockerfile.launcher copies into the image, in a stable order.
gods_eye_source_fingerprint() {
    {
        cat "$SCRIPT_DIR/Dockerfile.launcher" "$SCRIPT_DIR/pyproject.toml" "$SCRIPT_DIR/README.md"
        find "$SCRIPT_DIR/service" -type f \
            ! -name '*.pyc' ! -path '*/__pycache__/*' \
            | LC_ALL=C sort | while IFS= read -r source_file; do
            printf '%s\n' "$source_file"
            cat "$source_file"
        done
    } 2>/dev/null | gods_eye_digest
}

launcher_image=${GODS_EYE_LAUNCHER_IMAGE:-gods-eye-launcher:local}
GODS_EYE_SOURCE_FINGERPRINT=$(gods_eye_source_fingerprint)
export GODS_EYE_SOURCE_FINGERPRINT
built_fingerprint=$(docker image inspect \
    --format '{{index .Config.Labels "com.gods-eye.source-fingerprint"}}' \
    "$launcher_image" 2>/dev/null || true)

if [ "$built_fingerprint" = "$GODS_EYE_SOURCE_FINGERPRINT" ]; then
    build_reason=""
elif [ -z "$built_fingerprint" ]; then
    build_reason="no local Launcher image is present"
else
    build_reason="the checkout changed since the local Launcher image was built"
fi

if [ -n "$build_reason" ]; then
    printf 'Building the local Launcher image because %s.\n' "$build_reason" >&2
    printf '%s\n' "A cold build installs the full model stack and takes many minutes; leave it running." >&2
    if docker compose --project-directory "$SCRIPT_DIR" --profile tools build launcher >&2; then
        :
    else
        build_status=$?
        printf '%s\n' "Could not build the local Launcher image; the requested command was not run." >&2
        exit "$build_status"
    fi
fi
exec docker compose --project-directory "$SCRIPT_DIR" --profile tools run --rm launcher "$@"
